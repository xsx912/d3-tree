{
  "name": "@d3-tree/react",
  "version": "0.1.0",
  "description": "@d3-tree/core 的 React 组件封装",
  "keywords": [
    "d3",
    "tree",
    "graph",
    "visualization",
    "react",
    "react-component",
    "bidirectional-tree",
    "typescript"
  ],
  "license": "MIT",
  "author": "xsx912",
  "homepage": "https://github.com/xsx912/d3-tree#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xsx912/d3-tree.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/xsx912/d3-tree/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@d3-tree/core": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@d3-tree/core": "workspace:*",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.0"
  }
}
